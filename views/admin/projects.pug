extends ../common/layout

block layout-content 
  .main-content 
    h1.page-title Projects
    a.btn-primary(href="/admin/projects/add") Add Project
    table(border="1")
      thead
        tr
          th Title
          th Description
          th Languages
          th Technologies
          th Link
          th Actions
      tbody
        each project in projects
          tr
            td #{project.title}
            td #{project.description}
            td #{project.languages}
            td #{project.technologies}
            td: a(href=project.link, target="_blank") View
            td
              a(href=`/admin/projects/${project._id}/edit`) Edit
              |  | 
              a(href=`/admin/projects/${project._id}/delete`, onclick="return confirm('Delete this project?')") Delete
    if projects.length === 0
      p No projects yet. Please click "Add Project" above to create your first project.
