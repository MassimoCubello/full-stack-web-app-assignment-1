extends ../common/layout

block layout-content 
  .main-content 
    h1.page-title Edit Project
    form(method="post", action=`/admin/projects/${project._id}`)
      div 
        label(for="title") Title: 
        input(type="text", id="title", name="title", value=project.title, required)
      div 
        label(for="description") Description: 
        textarea(id="description", name="description", required) #{project.description}
      div 
        label(for="languages") Languages: 
        input(type="text", id="languages", name="languages", value=project.languages)
      div
        label(for="technologies") Technologies: 
        input(type="text", id="technologies", name="technologies", value=project.technologies)
      div 
        label(for="link") Link: 
        input(type="url", id="link", name="link", value=project.link)
      button(type="submit") Update Project
    p: a(href="/admin/projects") Back to Projects
